# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.bak

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables (strictly ignore all .env except .env.example)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Database
*.db
*.sqlite3

# Dependencies & Build artifacts (Frontend / Backend)
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
build/
*.egg-info/

# Logs & debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor clutter
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.tmp
*.local

# Temporary markdown & notes
suadoi.md
*.scratch.*

