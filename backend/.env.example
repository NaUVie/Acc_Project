# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Environment & Mode
ENVIRONMENT=development                # 'development' hoặc 'production'
ALLOW_MOCK_PAYMENT=true                # 'true' để test thanh toán giả lập nhanh, đặt 'false' khi chạy thật

# 2. Server & Network
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 3. Database (MySQL / MariaDB)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/acc_academy

# 4. Security & JWT
JWT_SECRET_KEY=ACC_ACADEMY_ULTRA_SECRET_KEY_FOR_JWT_TOKEN_123456789  # Tạo chuỗi bảo mật ngẫu nhiên: openssl rand -hex 32

# 5. Cloudinary (Lưu trữ ảnh / avatar / banner)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=Acc Demo
# Hoặc dùng chuỗi URL đầy đủ:
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# 6. VNPay Sandbox / Live Gateway
VNPAY_TMN_CODE=2QXUI4J4
VNPAY_HASH_SECRET=KASJDKASJDKASJDKASJDKASJDKASJDKA
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
