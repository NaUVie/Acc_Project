# Environment Settings
ENVIRONMENT=development # Set to 'production' on live server
ALLOW_MOCK_PAYMENT=true # Set to 'false' in production to disable instant mock payments

# Security Keys
JWT_SECRET_KEY=ACC_ACADEMY_ULTRA_SECRET_KEY_FOR_JWT_TOKEN_123456789 # Replace with openssl rand -hex 32

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Settings
HOST=0.0.0.0
PORT=8000
