# Environment Settings
ENVIRONMENT=development # Set to 'production' on live server
ALLOW_MOCK_PAYMENT=false # Set to 'false' in production to disable instant mock payments

# Security Keys
JWT_SECRET_KEY= # Replace with output of: openssl rand -hex 32

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Settings
HOST=0.0.0.0
PORT=8000
